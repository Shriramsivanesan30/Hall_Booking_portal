# ==========================================
# MCET College ERP - Seminar Hall Booking System
# Environment Configuration (.env)
# ==========================================

# Secret Key (Generate a secure unique 50+ character string for production)
SECRET_KEY=django-insecure-mcet-seminar-hall-booking-system-prod-key-dexoshpuse-2026!

# Debug mode: Set to False in production!
DEBUG=True

# Domain / Allowed Hosts (comma-separated)
ALLOWED_HOSTS=127.0.0.1,localhost,booking.dexoshpuse.com

# CSRF Trusted Origins (comma-separated with scheme)
CSRF_TRUSTED_ORIGINS=https://booking.dexoshpuse.com,http://127.0.0.1:8000,http://localhost:8000

# Database Configuration (MySQL for Production / MilesWeb, SQLite fallback if DB_ENGINE is sqlite)
# To use MySQL on MilesWeb or local MySQL:
# DB_ENGINE=mysql
# DB_NAME=mcet_seminar_booking
# DB_USER=mcet_user
# DB_PASSWORD=your_secure_password
# DB_HOST=localhost
# DB_PORT=3306
DB_ENGINE=sqlite
DB_NAME=db.sqlite3
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=

# Microsoft Entra ID / Microsoft 365 Outlook OAuth 2.0 Credentials
MICROSOFT_CLIENT_ID=your-microsoft-entra-app-client-id
MICROSOFT_CLIENT_SECRET=your-microsoft-entra-client-secret
MICROSOFT_TENANT_ID=your-microsoft-tenant-id-or-common
MICROSOFT_REDIRECT_URI=https://booking.dexoshpuse.com/auth/microsoft/callback/
# Allowed institutional email domains (comma-separated)
ALLOWED_EMAIL_DOMAINS=mcet.in,drmcet.ac.in

# Local Demo-Login Mode (Enabled for local dev / testing; MUST be False in production)
ENABLE_DEMO_LOGIN=True

# Email / SMTP Configuration
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=mail.booking.dexoshpuse.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=notifications@booking.dexoshpuse.com
EMAIL_HOST_PASSWORD=your-email-password
DEFAULT_FROM_EMAIL=MCET College ERP <notifications@booking.dexoshpuse.com>

# Security Settings for Production (enabled automatically when DEBUG=False)
# SECURE_SSL_REDIRECT=True
# SESSION_COOKIE_SECURE=True
# CSRF_COOKIE_SECURE=True
