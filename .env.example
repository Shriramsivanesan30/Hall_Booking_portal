# ==========================================
# MCET College ERP - Seminar Hall Booking System
# Environment Configuration (.env)
# ==========================================

# Secret Key (Generate a secure unique 50+ character string for production)
SECRET_KEY=django-insecure-mcet-seminar-hall-booking-system-prod-key-dexoshouse-2026!

# Debug mode: Set to False in production on MilesWeb!
DEBUG=False

# Domain / Allowed Hosts (comma-separated)
ALLOWED_HOSTS=bookings.dexoshouse.com,booking.dexoshouse.com,www.bookings.dexoshouse.com,127.0.0.1,localhost

# CSRF Trusted Origins (comma-separated with scheme)
CSRF_TRUSTED_ORIGINS=https://bookings.dexoshouse.com,https://booking.dexoshouse.com,http://127.0.0.1:8000,http://127.0.0.1:8003

# Database Configuration (MySQL for Production / MilesWeb, SQLite fallback if DB_ENGINE is sqlite)
# To use MySQL on MilesWeb:
DB_ENGINE=mysql
DB_NAME=cpaneluser_mcet_booking
DB_USER=cpaneluser_mcet_user
DB_PASSWORD=your_secure_db_password
DB_HOST=localhost
DB_PORT=3306

# Microsoft Entra ID / Microsoft 365 Outlook OAuth 2.0 Credentials
MICROSOFT_CLIENT_ID=your-microsoft-entra-app-client-id
MICROSOFT_CLIENT_SECRET=your-microsoft-entra-client-secret
MICROSOFT_TENANT_ID=common
MICROSOFT_REDIRECT_URI=https://bookings.dexoshouse.com/auth/microsoft/callback/
# Allowed institutional email domains (comma-separated)
ALLOWED_EMAIL_DOMAINS=mcet.in,drmcet.ac.in

# Local Demo-Login Mode (MUST be False in production)
ENABLE_DEMO_LOGIN=False

# Email / SMTP Configuration
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=mail.dexoshouse.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=notifications@dexoshouse.com
EMAIL_HOST_PASSWORD=your-email-password
DEFAULT_FROM_EMAIL=MCET College ERP <notifications@dexoshouse.com>

# Security Settings for Production (enabled automatically when DEBUG=False)
# SECURE_SSL_REDIRECT=True
# SESSION_COOKIE_SECURE=True
# CSRF_COOKIE_SECURE=True
